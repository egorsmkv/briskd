{erl_opts, [debug_info, warnings_as_errors]}.
%% Unused-export checks are left out: supervisor child specs, gen_server
%% callbacks, and public helper APIs are called dynamically or only from tests.
{xref_checks, [
    undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls
]}.
{deps, [{gen_smtp, "1.3.0"}, {livery_s3, "0.3.4"}]}.
{project_plugins, [{erlfmt, "1.8.0"}, {rebar3_ex_doc, "0.3.0"}]}.
%% `rebar3 ex_doc` (or `just docs`) writes HTML to doc/ from the -moduledoc and
%% -doc attributes. CI publishes it to GitHub Pages (.github/workflows/docs.yml).
{ex_doc, [
    {source_url, <<"https://github.com/egorsmkv/briskd">>},
    {homepage_url, <<"https://github.com/egorsmkv/briskd">>},
    {main, <<"readme">>},
    {extras, [
        {<<"README.md">>, #{filename => <<"readme">>, title => <<"Overview">>}},
        {<<"docs/configuration.md">>, #{title => <<"Configuration">>}},
        {<<"docs/irc-support.md">>, #{title => <<"IRC support">>}},
        {<<"docs/ircv3.md">>, #{title => <<"IRCv3">>}},
        {<<"docs/e2ee.md">>, #{title => <<"End-to-end encryption">>}},
        {<<"docs/bots.md">>, #{title => <<"AI assistant bots">>}},
        {<<"docs/calls.md">>, #{title => <<"Voice and video calls">>}},
        {<<"docs/webirc.md">>, #{title => <<"WebIRC">>}},
        {<<"docs/search.md">>, #{filename => <<"message-search">>, title => <<"Message search">>}},
        {<<"docs/deployment.md">>, #{title => <<"Deployment">>}},
        {<<"docs/development.md">>, #{title => <<"Development">>}},
        {<<"docs/mnesia.md">>, #{title => <<"Mnesia operations">>}},
        {<<"docs/conformance.md">>, #{title => <<"IRCv3 conformance">>}},
        {<<"bench/README.md">>, #{filename => <<"benchmarks">>, title => <<"Benchmarks">>}},
        {<<"ROADMAP.md">>, #{title => <<"Roadmap">>}},
        {<<"LICENSE.md">>, #{title => <<"License">>}}
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/configuration.md">>,
            <<"docs/irc-support.md">>,
            <<"docs/ircv3.md">>,
            <<"docs/e2ee.md">>,
            <<"docs/bots.md">>,
            <<"docs/calls.md">>,
            <<"docs/webirc.md">>,
            <<"docs/search.md">>,
            <<"docs/deployment.md">>,
            <<"docs/development.md">>
        ]},
        {<<"Operations">>, [
            <<"docs/mnesia.md">>, <<"docs/conformance.md">>, <<"bench/README.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Application and supervision">>, [
            briskd_app,
            briskd_sup,
            briskd_config,
            briskd_log,
            briskd_shutdown,
            briskd_ctl,
            briskd_webui,
            briskd_link_preview,
            briskd_bots,
            briskd_bot,
            briskd_bot_ai,
            briskd_calls,
            briskd_call_proto,
            briskd_bencode,
            briskd_altcha,
            briskd_mail
        ]},
        {<<"Connections">>, [
            briskd_listener,
            briskd_certs,
            briskd_sessions,
            briskd_session,
            briskd_flood,
            briskd_dronebl,
            briskd_websocket,
            briskd_wire
        ]},
        {<<"Protocol state">>, [
            briskd_state,
            briskd_state_client,
            briskd_state_channel,
            briskd_state_queries,
            briskd_state_info,
            briskd_state_send,
            briskd_deferred,
            briskd_isupport
        ]},
        {<<"IRCv3">>, [
            briskd_cap,
            briskd_conn,
            briskd_account,
            briskd_sasl,
            briskd_state_v3,
            briskd_state_history,
            briskd_state_batch,
            briskd_state_meta,
            briskd_state_monitor,
            briskd_e2ee,
            briskd_files,
            briskd_voice
        ]},
        {<<"Server links">>, [
            briskd_links,
            briskd_link,
            briskd_state_link,
            briskd_state_net,
            briskd_state_sync,
            briskd_route
        ]}
    ]}
]}.
{erlfmt, [
    write,
    {print_width, 100},
    {files, ["{src,include,test}/*.{hrl,erl,app.src}", "rebar.config"]}
]}.
%% mnesia is used but not a listed application: briskd_app sets its directory
%% before starting it. Dialyzer still needs it in the PLT.
{dialyzer, [
    {plt_extra_apps, [mnesia]},
    {warnings, [unmatched_returns, error_handling, extra_return, missing_return, unknown]}
]}.
{shell, [{apps, [briskd]}]}.
%% The prod release takes its distribution cookie from BRISKD_COOKIE.
{profiles, [
    {prod, [{relx, [{vm_args, false}, {vm_args_src, "config/vm.prod.args.src"}]}]}
]}.
%% Packaged node. mnesia is loaded, not started, so briskd_app can set its directory first.
{relx, [
    {release, {briskd, "1.0.0"}, [briskd, sasl, {mnesia, load}]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {overlay, [
        {copy, "bench/release.json", "etc/briskd.release.json"},
        {copy, "bin/briskdctl", "bin/briskdctl"}
    ]}
]}.
