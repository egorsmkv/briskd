{erl_opts, [debug_info, warnings_as_errors]}.
%% Unused-export checks are left out: supervisor child specs, gen_server
%% callbacks, and public helper APIs are called dynamically or only from tests.
{xref_checks, [
    undefined_function_calls, undefined_functions, locals_not_used, deprecated_function_calls
]}.
{deps, [{gen_smtp, "1.3.0"}, {livery_s3, "0.3.4"}]}.
{project_plugins, [{erlfmt, "1.8.0"}, {rebar3_ex_doc, "0.3.0"}]}.
%% `rebar3 ex_doc` (or `just docs`) writes HTML to doc/ from the -moduledoc and
%% -doc attributes. CI publishes it to GitHub Pages (.github/workflows/docs.yml).
{ex_doc, [
    {source_url, <<"https://github.com/egorsmkv/irc-server">>},
    {homepage_url, <<"https://github.com/egorsmkv/irc-server">>},
    {main, <<"readme">>},
    {extras, [
        {<<"README.md">>, #{filename => <<"readme">>, title => <<"Overview">>}},
        {<<"docs/configuration.md">>, #{title => <<"Configuration">>}},
        {<<"docs/irc-support.md">>, #{title => <<"IRC support">>}},
        {<<"docs/ircv3.md">>, #{title => <<"IRCv3">>}},
        {<<"docs/e2ee.md">>, #{title => <<"End-to-end encryption">>}},
        {<<"docs/bots.md">>, #{title => <<"AI assistant bots">>}},
        {<<"docs/calls.md">>, #{title => <<"Voice calls">>}},
        {<<"docs/deployment.md">>, #{title => <<"Deployment">>}},
        {<<"docs/development.md">>, #{title => <<"Development">>}},
        {<<"docs/mnesia.md">>, #{title => <<"Mnesia operations">>}},
        {<<"docs/conformance.md">>, #{title => <<"IRCv3 conformance">>}},
        {<<"bench/README.md">>, #{filename => <<"benchmarks">>, title => <<"Benchmarks">>}},
        {<<"ROADMAP.md">>, #{title => <<"Roadmap">>}},
        {<<"LICENSE.md">>, #{title => <<"License">>}}
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"docs/configuration.md">>,
            <<"docs/irc-support.md">>,
            <<"docs/ircv3.md">>,
            <<"docs/e2ee.md">>,
            <<"docs/bots.md">>,
            <<"docs/calls.md">>,
            <<"docs/deployment.md">>,
            <<"docs/development.md">>
        ]},
        {<<"Operations">>, [
            <<"docs/mnesia.md">>, <<"docs/conformance.md">>, <<"bench/README.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Application and supervision">>, [
            ircd_app,
            ircd_sup,
            ircd_config,
            ircd_log,
            ircd_shutdown,
            ircd_ctl,
            ircd_webui,
            ircd_link_preview,
            ircd_bots,
            ircd_bot,
            ircd_bot_ai,
            ircd_calls,
            ircd_call_proto,
            ircd_bencode,
            ircd_altcha,
            ircd_mail
        ]},
        {<<"Connections">>, [
            ircd_listener,
            ircd_certs,
            ircd_sessions,
            ircd_session,
            ircd_flood,
            ircd_dronebl,
            ircd_websocket,
            ircd_wire
        ]},
        {<<"Protocol state">>, [
            ircd_state,
            ircd_state_client,
            ircd_state_channel,
            ircd_state_queries,
            ircd_state_info,
            ircd_state_send,
            ircd_deferred,
            ircd_isupport
        ]},
        {<<"IRCv3">>, [
            ircd_cap,
            ircd_conn,
            ircd_account,
            ircd_sasl,
            ircd_state_v3,
            ircd_state_history,
            ircd_state_batch,
            ircd_state_meta,
            ircd_state_monitor,
            ircd_e2ee,
            ircd_files,
            ircd_voice
        ]},
        {<<"Server links">>, [
            ircd_links, ircd_link, ircd_state_link, ircd_state_net, ircd_state_sync, ircd_route
        ]}
    ]}
]}.
{erlfmt, [
    write,
    {print_width, 100},
    {files, ["{src,include,test}/*.{hrl,erl,app.src}", "rebar.config"]}
]}.
%% mnesia is used but not a listed application: ircd_app sets its directory
%% before starting it. Dialyzer still needs it in the PLT.
{dialyzer, [
    {plt_extra_apps, [mnesia]},
    {warnings, [unmatched_returns, error_handling, extra_return, missing_return, unknown]}
]}.
{shell, [{apps, [ircd]}]}.
%% The prod release takes its distribution cookie from IRCD_COOKIE.
{profiles, [
    {prod, [{relx, [{vm_args, false}, {vm_args_src, "config/vm.prod.args.src"}]}]}
]}.
%% Packaged node. mnesia is loaded, not started, so ircd_app can set its directory first.
{relx, [
    {release, {ircd, "0.1.0"}, [ircd, sasl, {mnesia, load}]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"},
    {overlay, [
        {copy, "bench/release.json", "etc/ircd.release.json"},
        {copy, "bin/ircdctl", "bin/ircdctl"}
    ]}
]}.
