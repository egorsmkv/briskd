# lego (ACME) settings for docker-compose.lego.yml. Copy to ./lego.env and edit.
# Every LEGO_* variable is read by lego itself; see `lego run --help`.

# The IRC server's public host name(s), comma-separated. They must resolve to
# this host for HTTP-01 and TLS-ALPN-01.
LEGO_DOMAINS=irc.example.org
# Contact address for the ACME account (expiry and policy notices).
LEGO_EMAIL=admin@example.org
# You must accept the CA's terms of service.
LEGO_ACCEPT_TOS=true

# CA. Test against staging first; its certificates are not trusted by
# clients but its rate limits are generous. Then switch to `letsencrypt`.
LEGO_SERVER=letsencrypt-staging

# Challenge: HTTP-01 needs port 80 reachable from the internet (the default).
LEGO_HTTP=true
# Or TLS-ALPN-01 on port 443 (publish 443 in docker-compose.lego.yml):
# LEGO_TLS=true
# Or DNS-01 through a provider API (no inbound port needed; wildcards work).
# Run `docker run --rm goacme/lego:v5.6.0 dnshelp -c <provider>` for its
# variables, for example:
# LEGO_DNS=cloudflare
# CF_DNS_API_TOKEN=...

LEGO_KEY_TYPE=EC256
LEGO_LOG_FORMAT=text

# lego.sh: seconds between renewal checks and after a failed run.
CHECK_INTERVAL=43200
RETRY_INTERVAL=3600
