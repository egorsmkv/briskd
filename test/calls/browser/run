#!/bin/sh
# Run the browser video-call test: briskd with WebIRC, rtpflux, and headless
# Chromium (see docker-compose.yml). Screenshots go to test/calls/browser/shots/.
set -eu
cd "$(dirname "$0")"
# shellcheck disable=SC1091
. "$(pwd)/../../../script/compose.sh"
mkdir -p shots
# The browser container may run as a different user than the one that created
# this directory. It only receives screenshots.
chmod 777 shots

cleanup() {
    compose -p briskd-calls-browser -f docker-compose.yml down -v >/dev/null 2>&1 || true
}
trap cleanup EXIT
status=0
compose -p briskd-calls-browser -f docker-compose.yml up --build --abort-on-container-exit \
    --exit-code-from browser || status=$?
exit "$status"
