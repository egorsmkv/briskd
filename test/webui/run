#!/bin/sh
# Screenshot WebIRC in light and dark themes and check contrast and page
# errors (see docker-compose.yml). Screenshots land in test/webui/shots/.
set -eu
cd "$(dirname "$0")"
mkdir -p shots
chmod 777 shots
if docker compose version >/dev/null 2>&1; then
    compose="docker compose"
else
    compose="docker-compose"
fi
status=0
$compose -p briskd-webui -f docker-compose.yml up --build --abort-on-container-exit \
    --exit-code-from tests || status=$?
$compose -p briskd-webui -f docker-compose.yml down -v >/dev/null 2>&1 || true
exit $status
