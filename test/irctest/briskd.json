{
  "name": "My.Little.Server",
  "network": "IRCTest",
  "server_info": "test server",
  "log_level": "warning",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": null,
  "mnesia_dir": "/tmp/briskd-irctest-db",
  "retention": "transient",
  "history_limit": 100,
  "account_password_min": 1,
  "resource_delay": 0,
  "nicklen": 30,
  "multiclient": true,
  "account_rejoin": true,
  "operators": [{"name": "operuser", "password": "operpassword"}],
  "max_clients": 10000
}
