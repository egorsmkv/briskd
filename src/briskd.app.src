{application, briskd, [
    {description, "IRC server"},
    {vsn, "0.1.0"},
    {registered, [
        briskd_sup, briskd_state, briskd_sessions, briskd_links, briskd_stats, briskd_search
    ]},
    {mod, {briskd_app, []}},
    {applications, [kernel, stdlib, crypto, public_key, ssl, gen_smtp, hackney, livery_s3]}
]}.
