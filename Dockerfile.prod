# Production image: build the web UI assets and the release (ERTS included),
# and run it on a slim Debian base that matches erlang:29.1.2 (Debian 13
# "trixie").

# Web UI: TypeScript/TSX bundle and stylesheets into priv/webui/assets. They
# are generated here and never committed.
FROM denoland/deno:2.9.8 AS webui
WORKDIR /src/webui
COPY webui ./
RUN deno task build

FROM erlang:29.1.2 AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*

ARG REBAR3_VERSION=3.28.0
RUN curl -fsSL \
        "https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3" \
        -o /usr/local/bin/rebar3 \
    && chmod +x /usr/local/bin/rebar3

WORKDIR /build
COPY rebar.config rebar.lock ./
RUN rebar3 as prod get-deps
COPY src src
COPY include include
COPY priv priv
COPY --from=webui /src/priv/webui/assets priv/webui/assets
COPY config config
COPY bin bin
COPY bench/release.json bench/release.json
RUN rebar3 as prod release

FROM debian:trixie-slim

# The ircd user has a fixed UID/GID (10001) so files written for it by other
# containers (TLS keys from lego, see docker-compose.lego.yml) can be owned by it.
# Runtime libraries the bundled ERTS and the crypto/ssl NIFs link against.
# libsctp1: without it every emulator prints an ESOCK warning on stdout,
# which the release script reads as the node's host name, so `ircd ping`,
# `eval`, and `remote_console` all report "Node is not running!".
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates libsctp1 libssl3t64 libstdc++6 libtinfo6 libzstd1 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 ircd \
    && useradd --system --uid 10001 --gid ircd --home-dir /var/lib/ircd \
        --shell /usr/sbin/nologin ircd \
    && mkdir -p /var/lib/ircd/mnesia /etc/ircd \
    && chown -R ircd:ircd /var/lib/ircd

COPY --from=build --chown=ircd:ircd /build/_build/prod/rel/ircd /opt/ircd
RUN ln -sf /opt/ircd/bin/ircdctl /usr/local/bin/ircdctl
COPY config/ircd.prod.json /etc/ircd/ircd.json
COPY config/motd.txt /etc/ircd/motd.txt

ENV IRCD_CONFIG=/etc/ircd/ircd.json \
    HOME=/var/lib/ircd

USER ircd
WORKDIR /var/lib/ircd
EXPOSE 6667 6697 8080 8081 8443

# SIGTERM makes the runtime call init:stop/0, which runs the graceful drain
# (ircd_shutdown) before the application stops.
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/ircd/bin/ircd"]
CMD ["foreground"]
