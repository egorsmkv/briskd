# Production image: build the web UI assets and the release (ERTS included),
# and run it on Alpine 3.24, the base of erlang:29.1.2-alpine, so the bundled
# ERTS finds the same musl, OpenSSL, and ncurses it was built against.

# Web UI: TypeScript/TSX bundle and stylesheets into priv/webui/assets. They
# are generated here and never committed.
FROM denoland/deno:alpine-2.9.8 AS webui
WORKDIR /src/webui
COPY webui ./
RUN deno task build

FROM erlang:29.1.2-alpine AS build

# cmake and a C/C++ toolchain build dependency NIFs; curl fetches rebar3.
RUN apk add --no-cache build-base cmake curl git

ARG REBAR3_VERSION=3.28.0
RUN curl -fsSL \
        "https://github.com/erlang/rebar3/releases/download/${REBAR3_VERSION}/rebar3" \
        -o /usr/local/bin/rebar3 \
    && chmod +x /usr/local/bin/rebar3

WORKDIR /build
COPY rebar.config rebar.lock ./
RUN rebar3 as prod get-deps
COPY src src
COPY include include
COPY priv priv
COPY --from=webui /src/priv/webui/assets priv/webui/assets
COPY config config
COPY bin bin
COPY bench/release.json bench/release.json
RUN rebar3 as prod release

FROM alpine:3.24.4

# The briskd user has a fixed UID/GID (10001) so files written for it by other
# containers (TLS keys from lego, see docker-compose.lego.yml) can be owned by it.
# Runtime libraries the bundled ERTS and the crypto/ssl NIFs link against.
# lksctp-tools: without libsctp every emulator prints an ESOCK warning on
# stdout, which the release script reads as the node's host name, so
# `briskd ping`, `eval`, and `remote_console` all report "Node is not running!".
# bash runs the release's start scripts.
RUN apk add --no-cache \
        bash ca-certificates libstdc++ lksctp-tools ncurses-libs openssl zlib zstd-libs \
    && addgroup -S -g 10001 briskd \
    && adduser -S -D -H -u 10001 -G briskd -h /var/lib/briskd -s /sbin/nologin briskd \
    && mkdir -p /var/lib/briskd/mnesia /etc/briskd \
    && chown -R briskd:briskd /var/lib/briskd

COPY --from=build --chown=briskd:briskd /build/_build/prod/rel/briskd /opt/briskd
RUN ln -sf /opt/briskd/bin/briskdctl /usr/local/bin/briskdctl
COPY config/briskd.prod.json /etc/briskd/briskd.json
COPY config/motd.txt /etc/briskd/motd.txt

ENV BRISKD_CONFIG=/etc/briskd/briskd.json \
    HOME=/var/lib/briskd

USER briskd
WORKDIR /var/lib/briskd
EXPOSE 6667 6697 8080 8081 8443

# SIGTERM makes the runtime call init:stop/0, which runs the graceful drain
# (briskd_shutdown) before the application stops.
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/briskd/bin/briskd"]
CMD ["foreground"]
