{
  "name": "irc.example.org",
  "network": "ExampleNet",
  "server_info": "Erlang/OTP IRC server",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": 6697,
  "ws_port": 8080,
  "wss_port": 8443,
  "certfile": "/etc/briskd/certs/fullchain.pem",
  "keyfile": "/etc/briskd/certs/privkey.pem",
  "log_level": "info",
  "log_format": "json",
  "max_clients": 10000,
  "motd_file": "/etc/briskd/motd.txt",
  "mnesia_dir": "/var/lib/briskd/mnesia",
  "retention": "channels",
  "history_limit": 500,
  "shutdown_grace": 10,
  "e2ee": {
    "max_devices": 8,
    "max_prekeys": 100,
    "queue_limit": 500,
    "queue_ttl": 1209600,
    "fetch_rate": 30
  },
  "operators": [],
  "administrators": [],
  "channels": [
    {
      "name": "#lobby",
      "topic": "Welcome! Say hello.",
      "modes": "nt"
    }
  ],
  "admin_name": "IRC server administrator",
  "admin_location1": "Not configured",
  "admin_location2": "Not configured",
  "admin_email": "Not configured",
  "client_password": null,
  "server_links": [],
  "tls_reload_interval": 60,
  "flood": {
    "lines_burst": 500,
    "lines_per_second": 50,
    "messages_burst": 200,
    "messages_per_second": 20,
    "join_burst": 50,
    "join_per_minute": 60,
    "nick_burst": 50,
    "nick_per_minute": 60,
    "register_per_minute": 30
  },
  "dronebl": false,
  "webui": null
}
