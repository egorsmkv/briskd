{
  "name": "irc.dev",
  "log_level": "trace",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": null,
  "ws_port": 8080,
  "network": "DevNet",
  "server_info": "DevNet IRC for developers and IT staff",
  "admin_name": "DevNet operators",
  "admin_location1": "Development network",
  "admin_location2": "irc.dev",
  "admin_email": "ops@irc.dev",
  "motd_file": "config/motd.dev.txt",
  "account_password_min": 4,
  "mnesia_dir": "/var/lib/briskd/mnesia",
  "retention": "channels",
  "history_limit": 100,
  "e2ee": {},
  "ai_providers": {
    "openai": { "base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY", "model": "gpt-6-luna" }
  },
  "bots": [
    {
      "nick": "guide",
      "realname": "DevNet guide (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/guide.txt",
      "channels": ["#lobby"],
      "temperature": 0.4,
      "max_reply_lines": 8
    },
    {
      "nick": "helpdesk",
      "realname": "IT helpdesk assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/helpdesk.txt",
      "channels": ["#helpdesk"],
      "temperature": 0.4,
      "max_reply_lines": 8
    },
    {
      "nick": "coder",
      "realname": "Software engineering assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/coder.txt",
      "channels": ["#dev"],
      "temperature": 0.3,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "reviewer",
      "realname": "Code review assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/reviewer.txt",
      "channels": ["#review"],
      "context": "channel",
      "history_lines": 30,
      "temperature": 0.2,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "oncall",
      "realname": "Incident and operations assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/oncall.txt",
      "channels": ["#ops", "#incident"],
      "context": "channel",
      "history_lines": 40,
      "temperature": 0.2,
      "max_tokens": 800,
      "max_reply_lines": 12,
      "requests_per_minute": 12
    },
    {
      "nick": "sysadm",
      "realname": "Systems assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/sysadm.txt",
      "channels": ["#infra"],
      "temperature": 0.3,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "netops",
      "realname": "Network assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/netops.txt",
      "channels": ["#net"],
      "temperature": 0.3,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "secop",
      "realname": "Security assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/secop.txt",
      "channels": ["#security"],
      "temperature": 0.2,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "dbadmin",
      "realname": "Database assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/dbadmin.txt",
      "channels": ["#data"],
      "temperature": 0.2,
      "max_tokens": 800,
      "max_reply_lines": 10
    },
    {
      "nick": "scribe",
      "realname": "Documentation assistant (machine-generated answers)",
      "provider": "openai",
      "system_prompt_file": "config/prompts/scribe.txt",
      "channels": ["#docs"],
      "context": "channel",
      "history_lines": 30,
      "temperature": 0.5,
      "max_tokens": 900,
      "max_reply_lines": 12
    }
  ],
  "voice": {
    "endpoint": "http://rustfs:9000",
    "region": "us-east-1",
    "bucket": "briskd-voice",
    "access_key_id": "rustfsadmin",
    "secret_access_key": "rustfsadmin",
    "max_bytes": 1048576,
    "max_duration": 120
  },
  "files": {
    "endpoint": "http://rustfs:9000",
    "region": "us-east-1",
    "bucket": "briskd-files",
    "access_key_id": "rustfsadmin",
    "secret_access_key": "rustfsadmin",
    "max_bytes": 10485760
  },
  "calls": { "rtpflux": "rtpflux:2223" },
  "features": {
    "reactions": true,
    "replies": true,
    "typing": true,
    "editing": true,
    "redaction": true,
    "link_previews": true
  },
  "administrators": [
    {"nick": "yehor", "password": "devpass"},
    {"nick": "admin", "password": "devpass"},
    {"nick": "ops", "password": "devpass"}
  ],
  "channels": [
    {"name": "#lobby", "topic": "Welcome to DevNet. Introductions and where to ask. Mention guide.", "modes": "nt"},
    {"name": "#announcements", "topic": "Staff announcements. Moderated: only operators and voiced users speak.", "modes": "ntm"},
    {"name": "#helpdesk", "topic": "IT support: access, devices, mail, VPN. Mention helpdesk. Do not paste passwords or tokens.", "modes": "nt"},
    {"name": "#dev", "topic": "Software design, debugging, and implementation. Mention coder.", "modes": "nt"},
    {"name": "#review", "topic": "Code review. Mention reviewer. Recent lines are sent to the model when reviewer answers.", "modes": "nt"},
    {"name": "#ops", "topic": "Deploys, changes, and reliability. Mention oncall. Recent lines are sent to the model when oncall answers. No secrets.", "modes": "nt"},
    {"name": "#incident", "topic": "Active incidents. Mention oncall. Recent lines are sent to the model when oncall answers. Keep secrets out.", "modes": "nt"},
    {"name": "#infra", "topic": "Hosts, containers, storage, and platform. Mention sysadm.", "modes": "nt"},
    {"name": "#net", "topic": "DNS, routing, firewalls, and TLS. Mention netops.", "modes": "nt"},
    {"name": "#security", "topic": "Defensive security and reviews. Mention secop. Do not paste secrets or exploit material.", "modes": "nt"},
    {"name": "#data", "topic": "Schemas, queries, migrations, and backups. Mention dbadmin. Do not paste production data.", "modes": "nt"},
    {"name": "#docs", "topic": "Runbooks, decision notes, and status updates. Mention scribe. Recent lines are sent to the model when scribe answers.", "modes": "nt"},
    {"name": "#random", "topic": "Off topic. Keep it kind.", "modes": "n"}
  ],
  "flood": {
    "lines_burst": 500,
    "lines_per_second": 50,
    "messages_burst": 200,
    "messages_per_second": 20,
    "join_burst": 50,
    "join_per_minute": 60,
    "nick_burst": 50,
    "nick_per_minute": 60,
    "register_per_minute": 30
  },
  "dronebl": {
    "enabled": true,
    "zone": "dnsbl.dronebl.org",
    "timeout_ms": 3000,
    "ban_ttl": 3600,
    "cache_ttl": 300,
    "types": "all",
    "skip_private": true,
    "max_entries": 10000,
    "max_in_flight": 64
  },
  "webui": {
    "bind": "0.0.0.0",
    "port": 8081,
    "username": "admin",
    "password": "change-me-strong-password",
    "terms_url": "https://example.com/terms",
    "privacy_url": "https://example.com/privacy"
  },
  "account_verification": {
    "ttl": 900,
    "verify_url": "http://localhost:8081/verify",
    "smtp": {
      "relay": "inbucket",
      "port": 2500,
      "from": "noreply@irc.dev",
      "tls": "never"
    }
  },
  "server_links": [
    {"name": "irc2.dev", "host": "briskd-dev2", "port": 6668, "password": "devnet-link", "tls": false}
  ],
  "search": {"url": "http://briskd-search:7700", "token": "dev-search-token", "max_results": 50}
}
