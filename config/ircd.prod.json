{
  "name": "irc.example.org",
  "network": "ExampleNet",
  "server_info": "Erlang/OTP IRC server",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": null,
  "ws_port": 8080,
  "wss_port": null,
  "certfile": null,
  "keyfile": null,
  "log_level": "info",
  "log_format": "json",
  "max_clients": 10000,
  "motd_file": "/etc/ircd/motd.txt",
  "mnesia_dir": "/var/lib/ircd/mnesia",
  "retention": "channels",
  "history_limit": 500,
  "shutdown_grace": 10,
  "operators": [],
  "administrators": [],
  "channels": [
    {"name": "#lobby", "topic": "Welcome! Say hello.", "modes": "nt"}
  ],
  "admin_name": "IRC server administrator",
  "admin_location1": "Not configured",
  "admin_location2": "Not configured",
  "admin_email": "Not configured",
  "client_password": null,
  "server_links": [],
  "flood": {
    "lines_burst": 500,
    "lines_per_second": 50,
    "messages_burst": 200,
    "messages_per_second": 20,
    "join_burst": 50,
    "join_per_minute": 60,
    "nick_burst": 50,
    "nick_per_minute": 60,
    "register_per_minute": 30
  },
  "dronebl": {
    "enabled": true,
    "zone": "dnsbl.dronebl.org",
    "timeout_ms": 3000,
    "ban_ttl": 3600,
    "cache_ttl": 300,
    "types": "all",
    "skip_private": true,
    "max_entries": 10000,
    "max_in_flight": 64
  },
  "webui": {
    "bind": "0.0.0.0",
    "port": 8081,
    "username": "admin",
    "password": "change-me-strong-password",
    "terms_url": "https://example.com/terms",
    "privacy_url": "https://example.com/privacy"
  }
}
