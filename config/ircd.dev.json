{
  "name": "irc.dev",
  "log_level": "trace",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": null,
  "ws_port": 8080,
  "network": "DevNet",
  "motd_file": "config/motd.txt",
  "account_password_min": 4,
  "mnesia_dir": "/var/lib/ircd/mnesia",
  "retention": "transient",
  "history_limit": 100,
  "administrators": [
    {"nick": "yehor", "password": "devpass"},
    {"nick": "admin", "password": "devpass"},
    {"nick": "ops", "password": "devpass"}
  ],
  "channels": [
    {"name": "#lobby", "topic": "Lobby", "modes": "nt"},
    {"name": "#dev", "topic": "Development", "modes": "nt"},
    {"name": "#random", "topic": "Random", "modes": "n"}
  ],
  "flood": {
    "lines_burst": 500,
    "lines_per_second": 50,
    "messages_burst": 200,
    "messages_per_second": 20,
    "join_burst": 50,
    "join_per_minute": 60,
    "nick_burst": 50,
    "nick_per_minute": 60,
    "register_per_minute": 30
  }
}
