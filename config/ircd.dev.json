{
  "name": "irc.dev",
  "log_level": "trace",
  "bind": "0.0.0.0",
  "tcp_port": 6667,
  "tls_port": null,
  "ws_port": 8080,
  "network": "DevNet",
  "motd_file": "config/motd.txt",
  "account_password_min": 4,
  "mnesia_dir": "/var/lib/ircd/mnesia",
  "retention": "channels",
  "history_limit": 100,
  "e2ee": {},
  "ai_providers": {
    "openai": { "base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY", "model": "gpt-4o-mini" }
  },
  "bots": [
    { "nick": "helper", "provider": "openai", "channels": ["#lobby"],
      "system_prompt": "You are a friendly helper. Answer briefly." }
  ],
  "voice": {
    "endpoint": "http://rustfs:9000",
    "region": "us-east-1",
    "bucket": "ircd-voice",
    "access_key_id": "rustfsadmin",
    "secret_access_key": "rustfsadmin",
    "max_bytes": 1048576,
    "max_duration": 120
  },
  "files": {
    "endpoint": "http://rustfs:9000",
    "region": "us-east-1",
    "bucket": "ircd-files",
    "access_key_id": "rustfsadmin",
    "secret_access_key": "rustfsadmin",
    "max_bytes": 10485760
  },
  "features": {
    "reactions": true,
    "replies": true,
    "typing": true,
    "editing": true,
    "redaction": true,
    "link_previews": true
  },
  "administrators": [
    {"nick": "yehor", "password": "devpass"},
    {"nick": "admin", "password": "devpass"},
    {"nick": "ops", "password": "devpass"}
  ],
  "channels": [
    {"name": "#lobby", "topic": "Lobby", "modes": "nt"},
    {"name": "#dev", "topic": "Development", "modes": "nt"},
    {"name": "#random", "topic": "Random", "modes": "n"}
  ],
  "flood": {
    "lines_burst": 500,
    "lines_per_second": 50,
    "messages_burst": 200,
    "messages_per_second": 20,
    "join_burst": 50,
    "join_per_minute": 60,
    "nick_burst": 50,
    "nick_per_minute": 60,
    "register_per_minute": 30
  },
  "dronebl": {
    "enabled": true,
    "zone": "dnsbl.dronebl.org",
    "timeout_ms": 3000,
    "ban_ttl": 3600,
    "cache_ttl": 300,
    "types": "all",
    "skip_private": true,
    "max_entries": 10000,
    "max_in_flight": 64
  },
  "webui": {
    "bind": "0.0.0.0",
    "port": 8081,
    "username": "admin",
    "password": "change-me-strong-password",
    "terms_url": "https://example.com/terms",
    "privacy_url": "https://example.com/privacy"
  },
  "account_verification": {
    "ttl": 900,
    "verify_url": "http://localhost:8081/verify",
    "smtp": {
      "relay": "inbucket",
      "port": 2500,
      "from": "noreply@irc.dev",
      "tls": "never"
    }
  }
}
