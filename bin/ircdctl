#!/bin/sh
# DevOps CLI for controlling and inspecting an ircd server.
#
# Talks to the running server over its local Unix domain control socket
# ($IRCD_CTL_SOCKET, or <mnesia_dir>/ircdctl.sock from $IRCD_CONFIG).
# Offline commands (`help`, `check-config <path>`) work without a running node.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

find_erl() {
    for candidate in \
        "$ROOT_DIR"/erts-*/bin/erl \
        /opt/ircd/erts-*/bin/erl
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v erl >/dev/null 2>&1; then
        command -v erl
        return 0
    fi
    for candidate in "$ROOT_DIR"/_build/prod/rel/ircd/erts-*/bin/erl; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

find_ebin() {
    for candidate in \
        "$ROOT_DIR"/lib/ircd-*/ebin \
        /opt/ircd/lib/ircd-*/ebin \
        "$ROOT_DIR"/_build/default/lib/ircd/ebin \
        "$ROOT_DIR"/_build/prod/lib/ircd/ebin \
        "$ROOT_DIR"/_build/test/lib/ircd/ebin
    do
        if [ -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ERL_BIN="$(find_erl || true)"
if [ -z "$ERL_BIN" ]; then
    echo "ircdctl: could not find erl executable" >&2
    exit 1
fi

EBIN_DIR="$(find_ebin || true)"
if [ -z "$EBIN_DIR" ]; then
    echo "ircdctl: could not find compiled ircd ebin directory (run 'just build' first)" >&2
    exit 1
fi

exec "$ERL_BIN" -noshell -boot no_dot_erlang -pa "$EBIN_DIR" \
    -eval 'halt(ircd_ctl:remote_cli(init:get_plain_arguments())).' \
    -extra "$@"
