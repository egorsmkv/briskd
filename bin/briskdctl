#!/bin/sh
# DevOps CLI for controlling and inspecting a briskd server.
#
# Talks to the running server over its local Unix domain control socket
# ($BRISKD_CTL_SOCKET, or <mnesia_dir>/briskdctl.sock from $BRISKD_CONFIG).
# Offline commands (`help`, `check-config <path>`) work without a running node.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"

find_erl() {
    # A release ships its own ERTS. Prefer that over whatever `erl` is on
    # PATH, so the emulator matches the beams in the release.
    for candidate in \
        "$ROOT_DIR"/erts-*/bin/erl \
        /opt/briskd/erts-*/bin/erl \
        "$ROOT_DIR"/_build/prod/rel/briskd/erts-*/bin/erl
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v erl >/dev/null 2>&1; then
        command -v erl
        return 0
    fi
    return 1
}

find_ebin() {
    for candidate in \
        "$ROOT_DIR"/lib/briskd-*/ebin \
        /opt/briskd/lib/briskd-*/ebin \
        "$ROOT_DIR"/_build/default/lib/briskd/ebin \
        "$ROOT_DIR"/_build/prod/lib/briskd/ebin \
        "$ROOT_DIR"/_build/test/lib/briskd/ebin
    do
        if [ -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

ERL_BIN="$(find_erl || true)"
if [ -z "$ERL_BIN" ]; then
    echo "briskdctl: could not find erl executable" >&2
    exit 1
fi

EBIN_DIR="$(find_ebin || true)"
if [ -z "$EBIN_DIR" ]; then
    echo "briskdctl: could not find compiled briskd ebin directory (run 'just build' first)" >&2
    exit 1
fi

exec "$ERL_BIN" -noshell -boot no_dot_erlang -pa "$EBIN_DIR" \
    -eval 'halt(briskd_ctl:remote_cli(init:get_plain_arguments())).' \
    -extra "$@"
